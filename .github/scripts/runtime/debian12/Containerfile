# syntax=docker/dockerfile:1
ARG DEBIAN_IMAGE
FROM ${DEBIAN_IMAGE} AS builder

ARG DEBIAN_NEXTCLOUD_PACKAGE_VERSION
RUN test -n "$DEBIAN_NEXTCLOUD_PACKAGE_VERSION"

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates \
      "libnextcloudsync0=${DEBIAN_NEXTCLOUD_PACKAGE_VERSION}" \
      "nextcloud-desktop-cmd=${DEBIAN_NEXTCLOUD_PACKAGE_VERSION}" \
      "nextcloud-desktop-common=${DEBIAN_NEXTCLOUD_PACKAGE_VERSION}" \
      "nextcloud-desktop-l10n=${DEBIAN_NEXTCLOUD_PACKAGE_VERSION}" \
 && test "$(dpkg-query -W -f='${Version}' nextcloud-desktop-cmd)" = "$DEBIAN_NEXTCLOUD_PACKAGE_VERSION" \
 && rm -rf /var/lib/apt/lists/*

COPY scripts/bundle.sh /usr/local/bin/bundle-nextcloudcmd
RUN chmod +x /usr/local/bin/bundle-nextcloudcmd \
 && /usr/local/bin/bundle-nextcloudcmd /bundle

FROM ${DEBIAN_IMAGE} AS test
ARG NEXTCLOUD_VERSION
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates file zip \
 && rm -rf /var/lib/apt/lists/*
COPY --from=builder /bundle/ /bundle/
RUN version="$(env -i HOME=/tmp PATH=/usr/bin:/bin \
      /bundle/opt/nextcloudcmd/bin/nextcloudcmd --version)" \
 && printf '%s\n' "$version" \
 && printf '%s\n' "$version" | grep -F "$NEXTCLOUD_VERSION" \
 && ! LD_LIBRARY_PATH=/bundle/opt/nextcloudcmd/lib \
      ldd /bundle/opt/nextcloudcmd/libexec/nextcloudcmd | grep -q 'not found' \
 && mkdir -p /release \
 && cd /bundle \
 && zip -9qr /release/nextcloudcmd-debian12-x86_64.zip opt \
 && cd /release \
 && sha256sum nextcloudcmd-debian12-x86_64.zip \
      > nextcloudcmd-debian12-x86_64.zip.sha256 \
 && du -sh /bundle/opt/nextcloudcmd /release/nextcloudcmd-debian12-x86_64.zip

FROM scratch AS artifact
COPY --from=test /release/ /
