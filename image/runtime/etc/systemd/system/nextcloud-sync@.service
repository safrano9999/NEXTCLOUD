[Unit]
Description=Nextcloud account %i synchronization
Requires=persistainer.service
After=network-online.target persistainer.service
Wants=network-online.target
Before=citadel-scan.service openclaw-ephemeral-schedule.service

[Service]
Type=oneshot
WorkingDirectory=/opt/safrano9999/NEXTCLOUD
ExecStart=/usr/bin/python3 /opt/safrano9999/NEXTCLOUD/nextcloud_sync.py --account %i
TimeoutStartSec=infinity
